# LLM 제공자: openai | anthropic | ollama
LLM_PROVIDER=openai
# 저비용 모델(라우팅·요약) / 고품질 모델(최종 합성·설명)
FAST_MODEL=gpt-4o-mini
QUALITY_MODEL=gpt-4o
# anthropic 예시: FAST_MODEL=claude-haiku-5-5  QUALITY_MODEL=claude-sonnet-5-5
# ollama 예시:   FAST_MODEL=qwen3:8b  QUALITY_MODEL=qwen3:8b  (langchain-ollama 설치 필요)

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# LangSmith 트레이싱
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=repoute-dev
